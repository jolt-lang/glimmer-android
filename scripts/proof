#!/usr/bin/env bash
# jolt proof DIR: the demo on an emulator, driven by taps and read
#   back through uiautomator; a screenshot at each step into DIR.
#   AVD=<name> picks the emulator: Medium_Phone_API_36.0 by default, and
#   for the second run any AVD with 16 KB pages. The helpers, and the boot
#   on console port 5580, are in emulator-lib. DIR keeps proof.txt, this
#   output, commit.txt, the commit it proved, and fetch-server.txt, the
#   log of scripts/fetch-server, which section 9 runs.
set -euo pipefail
IFS=$'\n\t'

# shellcheck disable=SC2034  # read by emulator-lib, which this sources, for its messages
TOOL=proof
AVD=${AVD:-Medium_Phone_API_36.0}
PKG=dev.staton.glimmer.demo
APK=android/demo/build/outputs/apk/debug/glimmer-demo-debug.apk
out=${1:?usage: jolt proof DIR}

# shellcheck source=scripts/emulator-lib
. "$(dirname "$0")/emulator-lib"

cd "$(git rev-parse --show-toplevel)"
[ -f "$APK" ] || die "no $APK — run: jolt demo"
mkdir -p "$out"
if [ -n "$(ls -A "$out")" ]; then die "$out is not empty; give a new directory"; fi
# the record: what was proved, and what said so
git rev-parse HEAD > "$out/commit.txt"
exec > >(tee "$out/proof.txt") 2>&1   # stderr too: a failed run's proof.txt says why it stopped
boot

# 1. launch
a shell am start -W -n "$PKG/glimmer.android.GlimmerActivity" >/dev/null
wait_for_log "glimmer-android: mounted" 30 || die "the screen never mounted; see adb logcat -s glimmer-android"
sleep 1; shot 1-launch
a shell dumpsys window displays | grep "mRotation=0 " >/dev/null \
  || die "the display turned by itself after the launch; see $out/1-launch.png"
check "the label says Tapped 0 times" has "Tapped 0 times"

# 2. tap the button, by input tap at its centre
IFS=" " read -r x y <<<"$(centre Tap)"
[ -n "${x:-}" ] || die "no Tap button in the tree"
a shell input tap "$x" "$y"
sleep 1; shot 2-tapped
check "input tap reached the button: Tapped 1 times" has "Tapped 1 times"

# 3. the label made to clip is logged as clipped
check "the clipped label is logged" wait_for_log 'clipped: "This label is far too long for its box"' 5

# 4. rotate: the Activity is rebuilt, the count survives, and a tap still works.
#    Android documents destroy, then create
#    (developer.android.com/guide/topics/resources/runtime-changes), but
#    C does not rely on it: a start that finds an older Activity tears its
#    screen down first, and a late stop from it is ignored.
stops() { a logcat -d -s "glimmer-android:*" | grep -c "glimmer-android: stopped" || true; }
before=$(stops)
rotate 1 || die "the display did not turn to landscape"
for _ in $(seq 1 15); do [ "$(stops)" -gt "$before" ] && break; sleep 1; done
[ "$(stops)" -gt "$before" ] || die "the old screen was never stopped"
sleep 2; shot 3-rotated
check "the count survived the rotation: Tapped 1 times" has "Tapped 1 times"
IFS=" " read -r x y <<<"$(centre Tap)"
a shell input tap "$x" "$y"
sleep 1; shot 4-tapped-again
check "a tap after the rotation works: Tapped 2 times" has "Tapped 2 times"

# 5. once per process, and what it cost
log=$(a logcat -d -s "glimmer-android:*")
inits=$(grep -c "jolt_library_init=0" <<<"$log" || true)
mounts=$(grep -c "glimmer-android: mounted" <<<"$log" || true)
check "jolt_library_init ran once ($inits)" test "$inits" = 1
check "the screen mounted twice, once per Activity ($mounts)" test "$mounts" = 2
grep -E "jolt_library_init=|entry ran in" <<<"$log" | sed 's/^/proof: /'

# 6. the vocabulary: every tag on one screen, in portrait so the
#    status bar is above it. The turn rebuilds the Activity; the count
#    is already taken.
before=$(stops)
rotate 0 || die "the display did not turn back to portrait"
for _ in $(seq 1 15); do [ "$(stops)" -gt "$before" ] && break; sleep 1; done
sleep 2; shot 5-portrait
IFS=" " read -r x y <<<"$(centre Next)"
[ -n "${x:-}" ] || die "no Next button in the tree"
a shell input tap "$x" "$y"
sleep 2; shot 6-vocabulary
# The scroll: four 48 dp buttons in 160 dp. uiautomator clips a node's
# bounds to what is in view, so a button partly scrolled out is shorter
# than one wholly in view.
tue='text="[^"]*Tuesday"'
thu='text="[^"]*Thursday"'
tall() {   # the height in view of the first node matching $1, or 0
  local y1 y2
  IFS=" " read -r _ y1 _ y2 <<<"$(bounds "$1")"
  echo $(( ${y2:-0} - ${y1:-0} ))
}
full=$(tall "$tue")
check "Tuesday's button is wholly in view ($full px)" test "$full" -gt 0
check "the fourth button is not wholly in view before a swipe ($(tall "$thu") px)" test "$(tall "$thu")" -lt "$full"
IFS=" " read -r sx1 sy1 sx2 sy2 <<<"$(bounds 'class="android.widget.ScrollView"')"
[ -n "${sy2:-}" ] || die "no ScrollView in the tree"
a shell input swipe $(( (sx1 + sx2) / 2 )) $(( sy2 - 20 )) $(( (sx1 + sx2) / 2 )) $(( sy1 + 20 )) 400
sleep 1; shot 7-scrolled
check "after the swipe the fourth button is wholly in view ($(tall "$thu") px)" test "$(tall "$thu")" -eq "$full"
inside() {   # the fourth button lies within the scroll's bounds
  local y1 y2
  IFS=" " read -r _ y1 _ y2 <<<"$(bounds "$thu")"
  [ "$y1" -ge "$sy1" ] && [ "$y2" -le "$sy2" ]
}
check "and inside the scroll, [$sy1, $sy2]" inside
mistake='content-desc="Example mistake"'
# whether the CheckBox described Example mistake reads checked="$1"
checked_is() {
  dump | tr '>' '\n' | grep 'class="android.widget.CheckBox"' | grep "$mistake" \
    | grep "checked=\"$1\"" >/dev/null
}
check "a CheckBox described Example mistake, checked=false" checked_is false
IFS=" " read -r x y <<<"$(centre_of "$mistake")"
[ -n "${x:-}" ] || die "no Example mistake box in the tree"
a shell input tap "$x" "$y"
sleep 1; shot 8-ticked
# checked alone could be Android's own toggle; the ✓ is set only by a re-render
ticked() { checked_is true && has "✓"; }
check "input tap ticked it: checked=true, and the re-render drew ✓" ticked
log=$(a logcat -d -s "glimmer-android:*")
check "no prop was unknown" test -z "$(grep "unknown prop" <<<"$log" || true)"
check "no call failed or threw" test -z "$(grep -E " failed| threw" <<<"$log" || true)"
grep "clipped:" <<<"$log" | sed 's/.*clipped:/clipped:/' | sort | uniq -c | sed 's/^ */proof: /' || true
# where the vocabulary's title sits: below the status bar by the safe inset
dump | tr '>' '\n' | grep 'text="Vocabulary"' | sed -n 's/.*\(bounds="[^"]*"\).*/proof: the title at \1/p' || true

# 7. the passages: wrapped labels in a scroll, most below the first
#    screen. In 0.1.0 ClipCheck logged a line that fit, as getLineWidth
#    counts the space it breaks at. Each must be unlogged once layout has
#    been quiet; ClipCheck walks 250 ms after the last pass.
clips() { a logcat -d -s "glimmer-android:*" | grep -c "clipped:" || true; }
before=$(clips)
IFS=" " read -r x y <<<"$(centre Passages)"
[ -n "${x:-}" ] || die "no Passages button in the tree"
a shell input tap "$x" "$y"
sleep 2; shot 9-passages
check "the passages show, the styled line first" has "Styled: bold, italic, struck, underlined"
check "no passage was logged as clipped ($(( $(clips) - before )))" test "$(clips)" = "$before"
log=$(a logcat -d -s "glimmer-android:*")
check "no markup element drew plain" test -z "$(grep "draws its text plain" <<<"$log" || true)"

# 8. Back: the passages take it, so Back reaches the callback and
#    shows the first screen; there nothing takes it, so a second Back is
#    Android's own, and the Activity leaves the foreground.
backs() { a logcat -d -s "glimmer-android:*" | grep -c "glimmer-android: back[[:space:]]*$" || true; }
a shell input keyevent 4
sleep 2; shot 10-back
check "input keyevent 4 reached the callback: the first screen's Tap is back" has "Tap"
check "C logged one Back ($(backs))" test "$(backs)" = 1
a shell input keyevent 4
sleep 2; shot 11-back-again
# dumpsys first: in a pipe after !, an adb that failed would read as gone
gone() {
  local w
  w=$(a shell dumpsys window) || return 1
  ! grep mCurrentFocus <<<"$w" | grep "$PKG" >/dev/null
}
check "a second Back, which nothing takes, sent the Activity away" gone
check "and did not reach the callback ($(backs))" test "$(backs)" = 1
log=$(a logcat -d -s "glimmer-android:*")
check "no call failed or threw after Back" test -z "$(grep -E " failed| threw" <<<"$log" || true)"

# 9. the fetch, against scripts/fetch-server on the Mac, which the
#    emulator reaches as 10.0.2.2:8765, and its port 8766, which never
#    accepts, for the connect timeout. The trap stops the server too.
python3 scripts/fetch-server >"$out/fetch-server.txt" 2>&1 &
server=$!
disown "$server"   # its kill at the exit is no job of bash's to report
trap 'kill "$server" 2>/dev/null || true; cleanup' EXIT
# curl -w prints 000 until something answers, whatever the status
for _ in $(seq 1 10); do
  [ "$(curl -s -o /dev/null -w '%{http_code}' http://127.0.0.1:8765/missing || true)" != 000 ] && break
  sleep 1
done
[ "$(curl -s -o /dev/null -w '%{http_code}' http://127.0.0.1:8765/missing || true)" != 000 ] \
  || die "the fetch server never answered on 127.0.0.1:8765; see $out/fetch-server.txt"
# section 8 sent the Activity away
a shell am start -W -n "$PKG/glimmer.android.GlimmerActivity" >/dev/null
sleep 2
dlog() { a logcat -d -s "glimmer-android:*"; }
check "the demo is debuggable" grep -q "glimmer-demo: debuggable? true" <<<"$(dlog)"
press() {   # tap the button labelled $1
  local x y
  IFS=" " read -r x y <<<"$(centre "$1")"
  [ -n "${x:-}" ] || die "no $1 button in the tree"
  a shell input tap "$x" "$y"
}
fetched() { dlog | grep "glimmer-demo: fetch $1 -> " | tail -n 1 || true; }
took() { sed -n 's/.* in \([0-9]*\) ms.*/\1/p' <<<"$1"; }
ask() {   # tap "Fetch $1", then wait for its answer
  press "Fetch $1"
  for _ in $(seq 1 12); do [ -n "$(fetched "$1")" ] && return 0; sleep 1; done
  die "fetch $1 never answered"
}
between() { [ "$1" -ge "$2" ] && [ "$1" -le "$3" ]; }
holds() { grep -qF -- "$2" <<<"$1"; }   # line $1 holds the text $2
press Fetches
sleep 2; shot 12-fetches

ask ok; line=$(fetched ok); echo "proof: $line"
check "ok answered 200" holds "$line" "-> 200"
check "with the body, astral character and header intact" holds "$line" "⛳🏌 ok X-Glimmer=demo"
ask missing; line=$(fetched missing); echo "proof: $line"
check "missing answered 404" holds "$line" "-> 404"
check "with its body" holds "$line" '"nothing here"'
ask connect; line=$(fetched connect); ms=$(took "$line"); echo "proof: $line"
check "connect timed out connecting" holds "$line" "-> error SocketTimeoutException"
check "in 1500–5000 ms (${ms:-none})" between "${ms:-0}" 1500 5000
ask silent; line=$(fetched silent); ms=$(took "$line"); echo "proof: $line"
check "silent timed out reading" holds "$line" "-> error SocketTimeoutException"
check "in 2500–5500 ms (${ms:-none})" between "${ms:-0}" 2500 5500
ask trickle; line=$(fetched trickle); ms=$(took "$line"); echo "proof: $line"
check "trickle hit the total" holds "$line" "-> error timeout"
check "in 5500–8000 ms (${ms:-none})" between "${ms:-0}" 5500 8000
ask big; line=$(fetched big); echo "proof: $line"
check "big was refused" holds "$line" "-> error body over 1 MiB"
shot 13-fetched

# the cancel: started, then cancelled a second later, with the
# connection open; its answer must never come. Both centres are read
# first: a dump takes a second or two, and the cancel must land well
# inside /slow's 5 s.
IFS=" " read -r fx fy <<<"$(centre "Fetch slow")"
IFS=" " read -r cx cy <<<"$(centre "Cancel slow")"
[ -n "${fx:-}" ] && [ -n "${cx:-}" ] || die "no Fetch slow or Cancel slow button in the tree"
a shell input tap "$fx" "$fy"
sleep 1
a shell input tap "$cx" "$cy"
sleep 7   # past /slow's 5 s and the total's 6 s
check "the slow fetch was cancelled" grep -q "glimmer-demo: fetch slow cancelled" <<<"$(dlog)"
check "and never answered" test -z "$(fetched slow)"
check "and nothing ran network I/O on the UI thread" \
  test -z "$(a logcat -d | grep NetworkOnMainThreadException || true)"

# a cancel with nothing pending
press "Cancel nothing"
sleep 1
check "a cancel with nothing pending answered nil" \
  grep -q "glimmer-demo: cancel with nothing pending -> nil" <<<"$(dlog)"
log=$(dlog)
check "nothing threw" test -z "$(grep " threw" <<<"$log" || true)"
check "no fetch failed in C" \
  test -z "$(grep -v "glimmer-demo:" <<<"$log" | grep -E "ga_fetch|Fetch" | grep "failed" || true)"
a logcat -d > "$out/logcat.txt"
echo "proof: all checks passed; pictures and logcat in $out"
