#!/usr/bin/env bash
# jolt demo: glimmer-android's demo as libglimmer_demo.so, then the APK
#   around it, with the C half compiled by Gradle.
set -euo pipefail
IFS=$'\n\t'

die() { printf 'demo: %s\n' "$*" >&2; exit 1; }

GRADLE_VERSION=9.8.0
GRADLE_SHA256=bafd5ce9cfaea0fbccfdc8439a1ac42fbd4cd9c89dc9a988228d8a2639a58e6c   # Gradle's own .sha256
CACHE=${CACHE:-$HOME/.cache/glimmer-android}
APP=android/demo
GRADLE="$CACHE/gradle-$GRADLE_VERSION/bin/gradle"

cd "$(git rev-parse --show-toplevel)"

# the Android SDK, and adb and the emulator from its platform-tools and emulator
[ -n "${ANDROID_HOME:-}" ] || die "ANDROID_HOME is not set; point it at the Android SDK, such as ~/Library/Android/sdk"
[ -d "$ANDROID_HOME" ] || die "ANDROID_HOME is $ANDROID_HOME, which is not a directory; point it at the Android SDK"
PATH="$ANDROID_HOME/platform-tools:$ANDROID_HOME/emulator:$PATH"

# A JDK 21 or newer for Gradle 9.8 and AGP 9.4: JAVA_HOME's, else java on
# PATH, as Gradle itself picks. java -version prints to stderr. macOS's
# /usr/bin/java is a stub that fails when no JDK is installed, so a java
# that fails, or prints no version, counts as none.
JDK_HINT="set JAVA_HOME to a JDK 21 or newer, or put its java on PATH"
java=java
[ -n "${JAVA_HOME:-}" ] && java="$JAVA_HOME/bin/java"
jv=$("$java" -version 2>&1) || die "no JDK: $java -version failed; $JDK_HINT"
jv=$(sed -n 's/.* version "\([^"]*\)".*/\1/p' <<<"$jv" | head -n 1)
case "$jv" in
  1.*) major=$(cut -d. -f2 <<<"$jv") ;;   # 1.8.0_x is Java 8
  *)   major=${jv%%[!0-9]*} ;;
esac
[ -n "$major" ] || die "no JDK: $java -version names no version; $JDK_HINT"
[ "$major" -ge 21 ] || die "$java is Java $jv, older than JDK 21; $JDK_HINT"

# Gradle, pinned without a wrapper: fetched once into CACHE, and checked
# against Gradle's published checksum every time it is fetched. It is
# unzipped beside the cache and moved into place only once whole, so an
# interrupted unzip never leaves a bin/gradle that looks installed.
if [ ! -x "$GRADLE" ]; then
  mkdir -p "$CACHE"
  stage=$(mktemp -d "$CACHE/.gradle-$GRADLE_VERSION.XXXXXX")
  trap 'rm -rf "$stage"' EXIT
  zip="$stage/gradle-$GRADLE_VERSION-bin.zip"
  curl -fsSL -o "$zip" "https://services.gradle.org/distributions/gradle-$GRADLE_VERSION-bin.zip"
  have=$(shasum -a 256 "$zip" | cut -d' ' -f1)
  [ "$have" = "$GRADLE_SHA256" ] || die "gradle-$GRADLE_VERSION-bin.zip is $have, not $GRADLE_SHA256"
  unzip -q "$zip" -d "$stage"
  [ -x "$stage/gradle-$GRADLE_VERSION/bin/gradle" ] || die "gradle-$GRADLE_VERSION-bin.zip holds no gradle-$GRADLE_VERSION/bin/gradle"
  rm -rf "$CACHE/gradle-$GRADLE_VERSION"   # a partial install from before this check
  mv "$stage/gradle-$GRADLE_VERSION" "$CACHE/"
fi

# the vocabulary's image, a build product: drawn once, never committed
png="$APP/src/main/assets/demo.png"
if [ ! -f "$png" ]; then
  command -v magick >/dev/null || die "no magick to draw $png — brew install imagemagick"
  mkdir -p "$(dirname "$png")"
  magick -size 64x64 gradient:'#2e7d32-#a5d6a7' "PNG32:$png"
fi

NS=glimmer-android.demo OUT=build/libglimmer_demo.so bash scripts/lib
mkdir -p "$APP/src/main/jniLibs/arm64-v8a"
cp build/libglimmer_demo.so "$APP/src/main/jniLibs/arm64-v8a/"

(cd "$APP" && "$GRADLE" --quiet --console=plain assembleDebug)
apk="$APP/build/outputs/apk/debug/glimmer-demo-debug.apk"   # rootProject.name
[ -f "$apk" ] || die "Gradle wrote no $apk"
echo "demo: wrote $apk ($(stat -f %z "$apk") bytes)"
