#!/usr/bin/env bash
# jolt demo: glimmer-android's demo as libglimmer_demo.so, then the APK
#   around it, with the C half compiled by Gradle.
set -euo pipefail
IFS=$'\n\t'

die() { printf 'demo: %s\n' "$*" >&2; exit 1; }

GRADLE_VERSION=9.8.0
CACHE=${CACHE:-$HOME/.cache/glimmer-android}
APP=android/demo
GRADLE="$CACHE/gradle-$GRADLE_VERSION/bin/gradle"

cd "$(git rev-parse --show-toplevel)"
[ -x "$GRADLE" ] || die "no Gradle at $GRADLE — install Gradle $GRADLE_VERSION there"

# the vocabulary's image, a build product: drawn once, never committed
png="$APP/src/main/assets/demo.png"
if [ ! -f "$png" ]; then
  command -v magick >/dev/null || die "no magick to draw $png — brew install imagemagick"
  mkdir -p "$(dirname "$png")"
  magick -size 64x64 gradient:'#2e7d32-#a5d6a7' "PNG32:$png"
fi

NS=glimmer-android.demo OUT=android/build/libglimmer_demo.so bash android/scripts/lib
mkdir -p "$APP/src/main/jniLibs/arm64-v8a"
cp android/build/libglimmer_demo.so "$APP/src/main/jniLibs/arm64-v8a/"

(cd "$APP" && "$GRADLE" --quiet --console=plain assembleDebug)
apk="$APP/build/outputs/apk/debug/glimmer-demo-debug.apk"   # rootProject.name
[ -f "$apk" ] || die "Gradle wrote no $apk"
echo "demo: wrote $apk ($(stat -f %z "$apk") bytes)"
