<?xml version="1.0" encoding="utf-8"?>
<!-- The demo's proof: plain HTTP to the Mac's server, as the emulator
     reaches it, and to the unroutable address that stands for a server
     that never accepts. Nothing else. -->
<network-security-config>
  <domain-config cleartextTrafficPermitted="true">
    <domain includeSubdomains="false">10.0.2.2</domain>
    <domain includeSubdomains="false">10.255.255.1</domain>
  </domain-config>
</network-security-config>
